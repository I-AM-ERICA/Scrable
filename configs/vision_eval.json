{
  "_comment": "Vision-3B (text only, no adapter) on the same 40 test reviews, prompt, RAG and judge as stage 2.",
  "backend": "local",
  "model": "naver-hyperclovax/HyperCLOVAX-SEED-Vision-Instruct-3B",
  "judge_backend": "anthropic",
  "judge_model": "claude-haiku-5-5",
  "judge_workers": 8,
  "device": "auto",
  "custom_data": "data/store_reviews.jsonl",
  "documents_dir": "data/store_docs",
  "base_prompt_file": "prompts/stage1_best_prompt.txt",
  "embedding_model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
  "train_size": 30,
  "validation_size": 10,
  "test_size": 40,
  "knowledge_size": 0,
  "top_k": 2,
  "output_dir": "outputs/vision_eval"
}
