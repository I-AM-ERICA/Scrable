{
  "_comment": "Stage 4 adapter on the same 40 synthetic test reviews as stage 2.",
  "backend": "local",
  "model": "naver-hyperclovax/HyperCLOVAX-SEED-Text-Instruct-1.5B",
  "response_adapter": "outputs/stage4/adapter",
  "judge_backend": "anthropic",
  "judge_model": "claude-haiku-5-5",
  "judge_workers": 8,
  "device": "auto",
  "custom_data": "data/store_reviews.jsonl",
  "documents_dir": "data/store_docs",
  "base_prompt_file": "prompts/stage4_prompt.txt",
  "embedding_model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
  "train_size": 30,
  "validation_size": 10,
  "test_size": 40,
  "knowledge_size": 0,
  "top_k": 2,
  "output_dir": "outputs/stage4_eval"
}
