{
  "_comment": "Email DPO: same recipe as stage2_dpo.json on synthetic emails to the train stores (data/dpo_emails.jsonl), trained together with the stage-2 review pairs (extra_pairs) into one fresh LoRA, so review replies are kept.",
  "base": {
    "backend": "local",
    "model": "naver-hyperclovax/HyperCLOVAX-SEED-Text-Instruct-1.5B",
    "judge_backend": "anthropic",
    "judge_model": "claude-haiku-5-5",
    "judge_workers": 8,
    "device": "auto",
    "channel": "email",
    "custom_data": "data/dpo_emails.jsonl",
    "documents_dir": "data/train_store_docs",
    "base_prompt_file": "prompts/email_prompt_v3.txt",
    "embedding_model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
    "knowledge_size": 0,
    "top_k": 2,
    "response_tokens": 384,
    "output_dir": "outputs/email_dpo"
  },
  "extra_pairs": ["outputs/stage2/pairs.jsonl"],
  "samples_per_review": 3,
  "temperature": 0.8,
  "top_p": 0.95,
  "teacher_models": [{"backend": "anthropic", "model": "claude-haiku-5-5"}],
  "min_margin": 0.15,
  "min_chosen_score": 0.6,
  "beta": 0.1,
  "sft_weight": 0.2,
  "learning_rate": 5e-5,
  "epochs": 2,
  "grad_accum": 8,
  "max_length": 2048,
  "eval_fraction": 0.1,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05
}
