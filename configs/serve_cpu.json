    "documents_dir": "data/store_docs",
    "base_prompt_file": "prompts/stage4_prompt.txt",
    "embedding_model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
    "knowledge_size": 0,
    "top_k": 2,
    "output_dir": "outputs/serve"
  },
  "store_aliases": {},
  "host": "127.0.0.1",
  "port": 50053,
  "workers": 8,
  "max_waiting": 32
}
